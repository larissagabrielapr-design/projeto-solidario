{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibpv-solidario",
  "account_id": "b01f226da6c240ff2468340b329f65a6",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "migrations_dir": "db/d1",
      "database_name": "ibpv-solidario",
      "binding": "DB",
      "database_id": "56a196bd-1d47-4354-a08b-0b17d5ce2b6a"
    }
  ],
  "r2_buckets": []
}
