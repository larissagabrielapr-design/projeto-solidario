# Desenvolvimento: D1 e R2 locais iniciam automaticamente, sem DATABASE_URL.
# Preencha os dois valores para criar o primeiro administrador em um banco local vazio.
ADMIN_EMAIL=
ADMIN_PASS=

# Legado PostgreSQL (somente rotinas de migração/produção Node):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Opcional: origem pública exata para validação de requisições.
# PUBLIC_ORIGIN=https://ENDERECO-GERADO-PELA-HOSPEDAGEM
